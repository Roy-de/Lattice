    "caption2": {
      "family": "Vadodara",
      "weight": 400,
      "desktop": { "size": "12px", "lineHeight": "18px", "letterSpacing": "0em" },
      "mobile":  { "size": "12px", "lineHeight": "18px", "letterSpacing": "0em" }
    },

    "number-sm": {
