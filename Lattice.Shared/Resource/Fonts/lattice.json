    },

    "button2": {
      "family": "Vadodara",
      "weight": 600,
      "desktop": { "size": "14px", "lineHeight": "20px", "letterSpacing": "0.01em" },
      "mobile":  { "size": "14px", "lineHeight": "20px", "letterSpacing": "0.01em" }
    },

    "button3": {
      "family": "Vadodara",
      "weight": 600,
      "desktop": { "size": "14px", "lineHeight": "20px", "letterSpacing": "0.02em" },
