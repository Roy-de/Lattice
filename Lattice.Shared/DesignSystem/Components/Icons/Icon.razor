@using Lattice.Shared.DesignSystem.Icons

@inject IconRegistry IconRegistry

@if (!string.IsNullOrEmpty(_content))
{
    <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="@_viewBox"
        width="@EffectiveWidth"
        height="@EffectiveHeight"
        fill="@Fill"
        stroke="@Stroke"
        stroke-width="@StrokeWidth"
        stroke-linecap="@StrokeLinecap"
        stroke-linejoin="@StrokeLinejoin"
        class="@Class"
        style="@Style"
        aria-hidden="@(Decorative ? "true" : "false")"
        aria-label="@AriaLabel"
        @attributes="AdditionalAttributes">

        @((MarkupString)_content)
    </svg>
}

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    // Dimensions
    [Parameter]
    public string Size { get; set; } = "24";

    [Parameter]
    public string? Width { get; set; }

    [Parameter]
    public string? Height { get; set; }

    // Appearance
    [Parameter]
    public string Stroke { get; set; } = "currentColor";

    [Parameter]
    public string Fill { get; set; } = "none";

    [Parameter]
    public string StrokeWidth { get; set; } = "2";

    [Parameter]
    public string StrokeLinecap { get; set; } = "round";

    [Parameter]
    public string StrokeLinejoin { get; set; } = "round";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    // Accessibility
    [Parameter]
    public bool Decorative { get; set; } = true;

    [Parameter]
    public string? AriaLabel { get; set; }

    // Advanced SVG attributes
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes
        { get; set; }

    private string _content = string.Empty;

    private string _viewBox = "0 0 24 24";

    private string EffectiveWidth => Width ?? Size;

    private string EffectiveHeight => Height ?? Size;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Name))
        {
            _content = string.Empty;
            return;
        }

        var icon = await IconRegistry.GetAsync(Name);

        _content = icon.Content;
        _viewBox = icon.ViewBox;
    }
}