@page "/design-system/foundations/colors/{PaletteId}"
@using Lattice.Shared.DesignSystem.Colors
@inject IColorPaletteService ColorPaletteService

<PageTitle>@(Palette?.Name ?? "Palette") · Lattice</PageTitle>

<div class="ds-page">
    @if (Palette is null)
    {
        <div class="ds-empty"><strong>Palette not found.</strong><br /><a href="/design-system/foundations/colors">Return to color palettes</a></div>
    }
    else
    {
        <header class="ds-page-header">
            <span class="ds-eyebrow">@Palette.Id / @Palette.Version</span><h1>@Palette.Name</h1><p>@Palette.Description</p>
            <div class="theme-toggle"><button class='@(Theme == "light" ? "active" : "")' @onclick='() => Theme = "light"'>Light</button><button class='@(Theme == "dark" ? "active" : "")' @onclick='() => Theme = "dark"'>Dark</button></div>
        </header>
        <section class="token-table" aria-label="Semantic color tokens">
            @foreach (var group in Tokens.GroupBy(t => t.Path.Split('.')[0]).OrderBy(g => g.Key))
            {
                <div class="token-group"><h2>@group.Key</h2>
                @foreach (var token in group)
                {
                    var value = Theme == "dark" ? token.DarkValue : token.LightValue;
                    <div class="token-row"><span class="token-swatch" style="background:@value"></span><div><strong>@token.Name</strong><code>@token.Path</code>@if (!string.IsNullOrWhiteSpace(token.Description)) { <small>@token.Description</small> }</div><code class="token-value">@value</code></div>
                }
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter] public string PaletteId { get; set; } = string.Empty;
    private ColorPalette? Palette { get; set; }
    private IReadOnlyList<ColorToken> Tokens { get; set; } = [];
    private string Theme { get; set; } = "light";
    protected override async Task OnParametersSetAsync()
    {
        Palette = ColorPaletteService.GetPalette(PaletteId) ?? await ColorPaletteService.LoadAsync(PaletteId);
        Tokens = ColorTokenResolver.GetSemanticTokens(Palette);
    }
}

<style>
    .theme-toggle { display:inline-flex; gap:3px; margin-top:22px; padding:3px; border-radius:8px; background:#eceee9; }.theme-toggle button { padding:6px 12px; border:0; border-radius:6px; background:transparent; color:#686b64; font:600 12px inherit; cursor:pointer; }.theme-toggle button.active { color:#1d332a; background:#fff; box-shadow:0 1px 3px #0001; }
    .token-table { display:grid; gap:28px; }.token-group { overflow:hidden; border:1px solid #e1e3dd; border-radius:12px; background:#fff; }.token-group h2 { margin:0; padding:13px 18px; border-bottom:1px solid #e8e9e5; color:#6e716a; background:#fafbf9; font-size:11px; letter-spacing:.09em; text-transform:uppercase; }.token-row { display:grid; grid-template-columns:32px minmax(0,1fr) auto; gap:13px; align-items:center; padding:14px 18px; border-bottom:1px solid #eff0ed; }.token-row:last-child { border:0; }.token-swatch { width:28px; height:28px; border:1px solid #00000012; border-radius:7px; }.token-row strong, .token-row code, .token-row small { display:block; }.token-row strong { font-size:13px; }.token-row code { margin-top:3px; color:#858780; font-size:11px; }.token-row small { margin-top:5px; color:#747770; font-size:12px; }.token-value { color:#3c403b !important; font-weight:650; }
    @@media(max-width:600px) { .token-row { grid-template-columns:28px minmax(0,1fr); padding:13px; }.token-value { grid-column:2; }.token-swatch { width:24px; height:24px; } }
</style>
