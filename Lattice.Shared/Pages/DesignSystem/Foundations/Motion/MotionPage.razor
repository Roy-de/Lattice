@page "/design-system/foundations/motion"
@page "/design-system/foundations/motion/{MotionId}"

@using Lattice.Shared.DesignSystem.Motion
@using Lattice.Shared.DesignSystem.Motion.Models

@inject IMotionService MotionService

<PageTitle>@(SelectedMotion?.Name ?? "Motion") · Lattice</PageTitle>

@if (MotionId is null)
{
    <div class="ds-page motion-index">

        <header class="ds-page-header">
            <span class="ds-eyebrow">
                Lattice UI / foundations
            </span>

            <h1>Motion systems</h1>

            <p>
                Explore the timing, easing, distance and interaction rules
                that define how Lattice interfaces move and respond.
            </p>
        </header>

        @if (MotionSystems.Count > 0)
        {
            <section
                class="motion-grid"
                aria-label="Available motion systems">

                @foreach (var system in MotionSystems)
                {
                    <a
                        class="motion-card"
                        href="@($"/design-system/foundations/motion/{system.Id}")">

                        <div class="motion-card-top">

                            <div>
                                <span class="motion-card-id">
                                    @system.Id
                                </span>

                                <h2>
                                    @system.Name
                                </h2>
                            </div>

                            <span class="inspect-link">
                                Inspect →
                            </span>

                        </div>

                        <p>
                            @system.Description
                        </p>

                        <div class="motion-personality">

                            @foreach (var personality in system.Personality)
                            {
                                <span class="motion-pill">
                                    @personality
                                </span>
                            }

                        </div>

                        <div class="motion-card-summary">

                            <div>
                                <strong>
                                    @system.Durations.Normal
                                </strong>

                                <span>
                                    Normal
                                </span>
                            </div>

                            <div>
                                <strong>
                                    @system.Durations.Fast
                                </strong>

                                <span>
                                    Fast
                                </span>
                            </div>

                            <div>
                                <strong>
                                    @system.Distances.Medium
                                </strong>

                                <span>
                                    Medium
                                </span>
                            </div>

                            <div>
                                <strong>
                                    @system.Accessibility
                                        .ReducedMotion
                                        .MaxDuration
                                </strong>

                                <span>
                                    Reduced motion
                                </span>
                            </div>

                        </div>

                    </a>
                }

            </section>
        }
        else
        {
            <div class="ds-empty">
                No motion systems have been loaded.
            </div>
        }

    </div>
}
else
{
    <div class="ds-page motion-detail">

        @if (SelectedMotion is null)
        {
            <div class="ds-empty">

                <strong>
                    Motion system not found.
                </strong>

                <br />

                <a href="/design-system/foundations/motion">
                    Return to motion systems
                </a>

            </div>
        }
        else
        {
            var motion = SelectedMotion;

            <header class="ds-page-header">

                <span class="ds-eyebrow">
                    @motion.Id / @motion.Version
                </span>

                <h1>
                    @motion.Name
                </h1>

                <p>
                    @motion.Description
                </p>

                <div class="motion-personality detail-personality">

                    @foreach (var personality in motion.Personality)
                    {
                        <span class="motion-pill">
                            @personality
                        </span>
                    }

                </div>

            </header>

            <section class="motion-section">

                <div class="motion-section-header">

                    <div>
                        <span class="section-eyebrow">
                            Primitives
                        </span>

                        <h2>Duration</h2>

                        <p>
                            Defines how long motion takes to complete.
                            Short durations are intended for immediate
                            interaction feedback while longer durations
                            support larger state changes.
                        </p>
                    </div>

                </div>

                <div class="token-grid">

                    @foreach (var token in GetDurations(motion))
                    {
                        <div class="token-card">

                            <div class="token-card-header">

                                <strong>
                                    @token.Name
                                </strong>

                                <code>
                                    @token.Value
                                </code>

                            </div>

                            <div class="motion-track duration-preview">
                                <div class="motion-object duration-object"
                                     style="@($"--motion-duration:{token.Value}")">
                                </div>
                            </div>

                        </div>
                    }

                </div>

            </section>

            <section class="motion-section">

                <div class="motion-section-header">

                    <div>
                        <span class="section-eyebrow">
                            Primitives
                        </span>

                        <h2>Easing</h2>

                        <p>
                            Defines how velocity changes throughout
                            a transition.
                        </p>
                    </div>

                </div>

                <div class="easing-grid">

                    @foreach (var easing in GetEasings(motion))
                    {
                        <article class="easing-card">

                            <div class="easing-card-header">

                                <strong>
                                    @easing.Name
                                </strong>

                                <code>
                                    @easing.Value
                                </code>

                            </div>

                            <div class="motion-track easing-preview">
                                <div class="motion-object easing-object"
                                     style="@($"--motion-easing:{easing.Value}")">
                                </div>
                            </div>

                        </article>
                    }

                </div>

            </section>

            <section class="motion-section">

                <div class="motion-section-header">

                    <div>
                        <span class="section-eyebrow">
                            Primitives
                        </span>

                        <h2>Distance</h2>

                        <p>
                            Defines how far an element can travel during
                            a motion transition.
                        </p>
                    </div>

                </div>

                <div class="distance-list">

                    @foreach (var distance in GetDistances(motion))
                    {
                        <div class="distance-row">

                            <div class="distance-name">

                                <strong>
                                    @distance.Name
                                </strong>

                                <code>
                                    @distance.Value
                                </code>

                            </div>

                            <div class="distance-track">

                                <div
                                    class="distance-object"
                                    style="@($"--distance:{distance.Value}")">
                                </div>

                            </div>

                        </div>
                    }

                </div>

            </section>

            <section class="motion-section">

                <div class="motion-section-header">

                    <div>
                        <span class="section-eyebrow">
                            Primitives
                        </span>

                        <h2>Scale</h2>

                        <p>
                            Restrained scale values for interaction and
                            content transitions.
                        </p>

                    </div>

                </div>

                <div class="scale-grid">

                    @foreach (var scale in GetScales(motion))
                    {
                        <div class="scale-card">

                            <div class="scale-preview">

                                <div
                                    class="scale-object"
                                    style="@($"--scale:{scale.Value}")">
                                </div>

                            </div>

                            <div class="scale-info">

                                <strong>
                                    @scale.Name
                                </strong>

                                <code>
                                    @scale.Value
                                </code>

                            </div>

                        </div>
                    }

                </div>

            </section>

            <section class="motion-section">

                <div class="motion-section-header">

                    <div>
                        <span class="section-eyebrow">
                            Primitives
                        </span>

                        <h2>Stagger</h2>

                        <p>
                            Controls the delay between related elements
                            entering or changing state.
                        </p>

                    </div>

                </div>

                <div class="stagger-grid">

                    @foreach (var stagger in GetStaggers(motion))
                    {
                        <div class="stagger-card">

                            <div>
                                <strong>
                                    @stagger.Name
                                </strong>

                                <code>
                                    @stagger.Value
                                </code>
                            </div>

                            <div class="stagger-preview">

                                @for (var i = 0; i < 5; i++)
                                {
                                    <span
                                        style="@($"--stagger-delay:{stagger.Value};--stagger-index:{i}")">
                                    </span>
                                }

                            </div>

                        </div>
                    }

                </div>

            </section>

            <section class="motion-section">

                <div class="motion-section-header">

                    <div>
                        <span class="section-eyebrow">
                            Semantic
                        </span>

                        <h2>Interaction</h2>

                        <p>
                            Motion assigned to direct user interaction.
                        </p>

                    </div>

                </div>

                <div class="semantic-grid">

                    <div class="semantic-card">

                        <div class="semantic-card-header">

                            <strong>Hover</strong>

                            <code>
                                @motion.Semantic.Interaction.Hover.Duration
                            </code>

                        </div>

                        <button class="motion-demo-button motion-hover">
                            Hover me
                        </button>

                        <div class="semantic-values">

                            <span>
                                <small>Duration</small>

                                <code>
                                    @motion.Semantic.Interaction.Hover.Duration
                                </code>
                            </span>

                            <span>
                                <small>Easing</small>

                                <code>
                                    @motion.Semantic.Interaction.Hover.Easing
                                </code>
                            </span>

                        </div>

                    </div>

                    <div class="semantic-card">

                        <div class="semantic-card-header">

                            <strong>Press</strong>

                            <code>
                                @motion.Semantic.Interaction.Press.Duration
                            </code>

                        </div>

                        <button class="motion-demo-button motion-press">
                            Press me
                        </button>

                        <div class="semantic-values">

                            <span>
                                <small>Duration</small>

                                <code>
                                    @motion.Semantic.Interaction.Press.Duration
                                </code>
                            </span>

                            <span>
                                <small>Scale</small>

                                <code>
                                    @motion.Semantic.Interaction.Press.Scale
                                </code>
                            </span>

                        </div>

                    </div>

                    <div class="semantic-card">

                        <div class="semantic-card-header">

                            <strong>Focus</strong>

                            <code>
                                @motion.Semantic.Interaction.Focus.Duration
                            </code>

                        </div>

                        <button class="motion-demo-button motion-focus">
                            Focus me
                        </button>

                        <div class="semantic-values">

                            <span>
                                <small>Duration</small>

                                <code>
                                    @motion.Semantic.Interaction.Focus.Duration
                                </code>
                            </span>

                            <span>
                                <small>Easing</small>

                                <code>
                                    @motion.Semantic.Interaction.Focus.Easing
                                </code>
                            </span>

                        </div>

                    </div>

                </div>

            </section>

            <section class="motion-section">

                <div class="motion-section-header">

                    <div>
                        <span class="section-eyebrow">
                            Semantic
                        </span>

                        <h2>Content</h2>

                        <p>
                            Motion used when content enters the interface.
                        </p>

                    </div>

                </div>

                <div class="content-demo-grid">

                    <div class="content-demo-card">

                        <div class="content-demo-top">

                            <strong>Fade in</strong>

                            <button
                                class="replay-button"
                                @onclick="ReplayFade">
                                Replay
                            </button>

                        </div>

                        <div
                            @key="fadeKey"
                            class="content-object motion-fade">
                        </div>

                        <code>
                            @motion.Semantic.Content.FadeIn.Duration
                        </code>

                    </div>

                    <div class="content-demo-card">

                        <div class="content-demo-top">

                            <strong>Fade up</strong>

                            <button
                                class="replay-button"
                                @onclick="ReplayFadeUp">
                                Replay
                            </button>

                        </div>

                        <div
                            @key="fadeUpKey"
                            class="content-object motion-fade-up">
                        </div>

                        <code>
                            @motion.Semantic.Content.FadeUp.Duration
                        </code>

                    </div>

                    <div class="content-demo-card">

                        <div class="content-demo-top">

                            <strong>Scale in</strong>

                            <button
                                class="replay-button"
                                @onclick="ReplayScale">
                                Replay
                            </button>

                        </div>

                        <div
                            @key="scaleKey"
                            class="content-object motion-scale-in">
                        </div>

                        <code>
                            @motion.Semantic.Content.ScaleIn.Duration
                        </code>

                    </div>

                </div>

            </section>

            <section class="motion-section">

                <div class="motion-section-header">

                    <div>
                        <span class="section-eyebrow">
                            Semantic
                        </span>

                        <h2>Surfaces</h2>

                        <p>
                            Motion used when layered interface surfaces
                            enter and leave the viewport.
                        </p>

                    </div>

                </div>

                <div class="surface-grid">

                    <div class="surface-card">

                        <div class="surface-card-header">

                            <strong>
                                Popover
                            </strong>

                            <span>
                                Enter
                            </span>

                        </div>

                        <div class="surface-preview">

                            <div
                                @key="popoverEnterKey"
                                class="surface-object popover-enter">
                            </div>

                        </div>

                        <code>
                            @motion.Semantic.Surface.PopoverEnter.Duration
                        </code>

                    </div>

                    <div class="surface-card">

                        <div class="surface-card-header">

                            <strong>
                                Dialog
                            </strong>

                            <button
                                class="replay-button"
                                @onclick="ReplayDialog">
                                Replay
                            </button>

                        </div>

                        <div class="surface-preview">

                            <div
                                @key="dialogKey"
                                class="dialog-object">
                                Example dialog
                            </div>

                        </div>

                        <code>
                            @motion.Semantic.Surface.DialogEnter.Duration
                        </code>

                    </div>

                </div>

            </section>

            <section class="motion-section">

                <div class="motion-section-header">

                    <div>
                        <span class="section-eyebrow">
                            Semantic
                        </span>

                        <h2>Feedback</h2>

                        <p>
                            Motion for transient system feedback.
                        </p>

                    </div>

                </div>

                <div class="feedback-demo">

                    <div class="feedback-notification">

                        <span class="feedback-dot"></span>

                        <div>

                            <strong>
                                Changes saved
                            </strong>

                            <span>
                                Your settings have been updated.
                            </span>

                        </div>

                    </div>

                </div>

            </section>

            <section class="motion-section">

                <div class="motion-section-header">

                    <div>
                        <span class="section-eyebrow">
                            Guidelines
                        </span>

                        <h2>Principles</h2>

                        <p>
                            Rules that govern how motion should be used
                            throughout Lattice.
                        </p>

                    </div>

                </div>

                <div class="principles-list">

                    @foreach (var principle in motion.Principles)
                    {
                        <article class="principle-card">

                            <span class="principle-index">
                                @GetPrincipleIndex(motion, principle)
                            </span>

                            <div>

                                <h3>
                                    @ToTitleCase(principle.Id)
                                </h3>

                                <p>
                                    @principle.Description
                                </p>

                            </div>

                        </article>
                    }

                </div>

            </section>

            <section class="motion-section">

                <div class="motion-section-header">

                    <div>
                        <span class="section-eyebrow">
                            Accessibility
                        </span>

                        <h2>Reduced motion</h2>

                        <p>
                            Motion should preserve meaning while respecting
                            users who prefer reduced movement.
                        </p>

                    </div>

                </div>

                <div class="accessibility-grid">

                    <div>
                        <small>Enabled</small>

                        <strong>
                            @(motion.Accessibility
                                .ReducedMotion
                                .Enabled ? "Yes" : "No")
                        </strong>
                    </div>

                    <div>
                        <small>Strategy</small>

                        <strong>
                            @motion.Accessibility
                                .ReducedMotion
                                .Strategy
                        </strong>
                    </div>

                    <div>
                        <small>Maximum duration</small>

                        <strong>
                            @motion.Accessibility
                                .ReducedMotion
                                .MaxDuration
                        </strong>
                    </div>

                    <div>
                        <small>Opacity</small>

                        <strong>
                            @(motion.Accessibility
                                .ReducedMotion
                                .AllowOpacity
                                    ? "Allowed"
                                    : "Disabled")
                        </strong>
                    </div>

                    <div>
                        <small>Transform</small>

                        <strong>
                            @(motion.Accessibility
                                .ReducedMotion
                                .AllowTransform
                                    ? "Allowed"
                                    : "Disabled")
                        </strong>
                    </div>

                    <div>
                        <small>Scale</small>

                        <strong>
                            @(motion.Accessibility
                                .ReducedMotion
                                .AllowScale
                                    ? "Allowed"
                                    : "Disabled")
                        </strong>
                    </div>

                </div>

            </section>
        }
    </div>
}

@code {

    [Parameter]
    public string? MotionId { get; set; }

    private MotionSystem? SelectedMotion { get; set; }

    private IReadOnlyList<MotionSystem> MotionSystems { get; set; }
        = Array.Empty<MotionSystem>();

    private int fadeKey;
    private int fadeUpKey;
    private int scaleKey;
    private int dialogKey;
    private int popoverEnterKey;

    protected override void OnInitialized()
    {
        MotionSystems = MotionService
            .GetMotionSystemsSorted();
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(MotionId))
        {
            SelectedMotion = null;
            return;
        }

        SelectedMotion =
            MotionService.GetMotionSystem(MotionId);
    }

    private void ReplayFade()
    {
        fadeKey++;
    }

    private void ReplayFadeUp()
    {
        fadeUpKey++;
    }

    private void ReplayScale()
    {
        scaleKey++;
    }

    private void ReplayDialog()
    {
        dialogKey++;
    }

    private void ReplayPopoverEnter()
    {
        popoverEnterKey++;
    }

    private static string GetPrincipleIndex(
        MotionSystem motion,
        MotionPrinciple principle)
    {
        var index = motion.Principles.IndexOf(principle);

        return (index + 1).ToString("00");
    }

    private static string ToTitleCase(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return value;
        }

        return string.Join(
            " ",
            value
                .Split(
                    '-',
                    StringSplitOptions.RemoveEmptyEntries)
                .Select(word =>
                    word.Length == 1
                        ? word.ToUpperInvariant()
                        : char.ToUpperInvariant(word[0])
                          + word[1..]));
    }

    private static IEnumerable<MotionTokenItem> GetDurations(
        MotionSystem motion)
    {
        yield return new("Instant", motion.Durations.Instant);
        yield return new("Micro", motion.Durations.Micro);
        yield return new("Fast", motion.Durations.Fast);
        yield return new("Normal", motion.Durations.Normal);
        yield return new("Moderate", motion.Durations.Moderate);
        yield return new("Slow", motion.Durations.Slow);
        yield return new("Deliberate", motion.Durations.Deliberate);
    }

    private static IEnumerable<MotionTokenItem> GetEasings(
        MotionSystem motion)
    {
        yield return new("Linear", motion.Easings.Linear);
        yield return new("Standard", motion.Easings.Standard);
        yield return new("Enter", motion.Easings.Enter);
        yield return new("Exit", motion.Easings.Exit);
    }

    private static IEnumerable<MotionTokenItem> GetDistances(
        MotionSystem motion)
    {
        yield return new("None", motion.Distances.None);
        yield return new("Micro", motion.Distances.Micro);
        yield return new("Subtle", motion.Distances.Subtle);
        yield return new("Small", motion.Distances.Small);
        yield return new("Medium", motion.Distances.Medium);
        yield return new("Large", motion.Distances.Large);
        yield return new("Dramatic", motion.Distances.Dramatic);
    }

    private static IEnumerable<MotionScaleItem> GetScales(
        MotionSystem motion)
    {
        yield return new("None", motion.Scale.None);
        yield return new("Subtle Down", motion.Scale.SubtleDown);
        yield return new("Small Down", motion.Scale.SmallDown);
        yield return new("Subtle Up", motion.Scale.SubtleUp);
        yield return new("Small Up", motion.Scale.SmallUp);
    }

    private static IEnumerable<MotionTokenItem> GetStaggers(
        MotionSystem motion)
    {
        yield return new("Subtle", motion.Stagger.Subtle);
        yield return new("Normal", motion.Stagger.Normal);
        yield return new("Slow", motion.Stagger.Slow);
    }

    private sealed record MotionTokenItem(
        string Name,
        string Value);

    private sealed record MotionScaleItem(
        string Name,
        double Value);
}
