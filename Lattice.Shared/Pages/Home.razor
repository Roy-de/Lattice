@*@page "/"
@using Lattice.Shared.Services
@using Lattice.Shared.Typography
@using Microsoft.Extensions.Logging

@inject IFormFactor FormFactor
@inject ITypographyService TypographyService
@inject ITypographyCssGenerator CssGenerator
@inject ILogger<Home> Logger

@{
    var css = CssGenerator.Generate(TypographyService.Current);
    
    // Log from the component as well
    Logger.LogInformation("Home component CSS generated, length: {Length}", css.Length);
    System.Diagnostics.Debug.WriteLine("=== Home Component CSS ===");
    System.Diagnostics.Debug.WriteLine(css);
    System.Diagnostics.Debug.WriteLine("=== End Home Component CSS ===");
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lattice</title>
    <base href="/" />
    $1$ <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" /> #1#
    <link href="css/app.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png" />
    
    <style>
        @css
    </style>
</head>

<PageTitle>Home</PageTitle>

<div class="text-display">
    Ledger
</div>

<div class="text-heading-1">
    Typography System
</div>

<div class="text-heading-2">
    Dynamic typography
</div>

<div class="text-body-large">
    This text is using the Ledger typography preset.
</div>

<div class="text-body">
    The typography definition is loaded from ledger.json.
</div>

<div class="text-body-small">
    Small supporting text.
</div>

<div class="text-caption">
    CAPTION TEXT
</div>

<hr />

<h3>Runtime information</h3>

<p>
    Running on <strong>@Factor</strong>
    using <strong>@Platform</strong>.
</p>

@code {
    private string Factor => FormFactor.GetFormFactor();

    private string Platform => FormFactor.GetPlatform();
    
}*@