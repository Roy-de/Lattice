      </Content>
    </ItemGroup>

    <ItemGroup>
      <MauiXaml Remove="Resources\Fonts\**" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Resources\Fonts\**" />
    </ItemGroup>

    <ItemGroup>
      <AndroidAarLibrary Remove="Resources\Fonts\**" />
