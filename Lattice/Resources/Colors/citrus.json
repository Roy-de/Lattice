{
  "id": "citrus",
  "name": "Citrus",
  "version": "2.0.0",
  "description": "A natural palette grounded in wood, foliage, stone and warm daylight.",
  "personality": "Organic, grounded, approachable and warm.",
  "intendedFor": [
    "Lifestyle products, wellness tools and brands that want an earthy tone."
  ],
  "keywords": [
    "natural",
    "grounded",
    "warm",
    "organic",
    "fresh",
    "friendly"
  ],
  "colorModel": {
    "space": "HEX",
    "architecture": "primitive-semantic-component",
    "supportsThemes": true,
    "themes": [
      "light",
      "dark"
    ]
  },
  "primitives": {
    "brand": {
      "primary": {
        "id": "brand-primary",
        "name": "Citrus Primary",
        "description": "Principal brand color for identity, emphasis and interaction.",
        "scale": {
          "50": "#F1F2F1",
          "100": "#DFE0DF",
          "200": "#B9BDBB",
          "300": "#8B908E",
          "400": "#4F5753",
          "500": "#17221D",
          "600": "#131D18",
          "700": "#101714",
          "800": "#0C1210",
          "900": "#090D0B",
          "950": "#060807"
        }
      },
      "secondary": {
        "id": "brand-secondary",
        "name": "Citrus Secondary",
        "description": "Supporting brand accent for secondary actions and expressive moments.",
        "scale": {
          "50": "#F2F4F3",
          "100": "#E0E6E3",
          "200": "#BDC8C3",
          "300": "#91A49A",
          "400": "#587566",
          "500": "#234936",
          "600": "#1D3D2D",
          "700": "#183225",
          "800": "#13271D",
          "900": "#0E1C15",
          "950": "#09120E"
        }
      }
    },
    "neutral": {
      "id": "neutral",
      "name": "Citrus Neutral",
      "description": "Balanced blue-slate neutrals for hierarchy and readable interfaces.",
