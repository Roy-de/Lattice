  "semantic": {
    "background": {
      "default": {
        "name": "Application Background",
        "description": "Primary application canvas.",
        "light": "neutral.50",
        "dark": "neutral.950"
      },
      "subtle": {
        "name": "Subtle Background",
        "description": "Secondary application region.",
        "light": "neutral.100",
        "dark": "neutral.900"
      }
    },
    "surface": {
      "default": {
        "name": "Surface",
        "description": "Default contained content surface.",
        "light": "neutral.0",
        "dark": "neutral.900"
      },
      "subtle": {
        "name": "Subtle Surface",
        "description": "Low-emphasis surface for secondary content.",
        "light": "neutral.50",
        "dark": "neutral.800"
      },
      "elevated": {
        "name": "Elevated Surface",
        "description": "Surface visually separated from its parent.",
        "light": "neutral.0",
        "dark": "neutral.800"
      },
      "sunken": {
        "name": "Sunken Surface",
        "description": "Recessed surface for fields and inset content.",
        "light": "neutral.100",
        "dark": "neutral.950"
      },
      "overlay": {
        "name": "Overlay",
        "description": "Modal and overlay surface.",
        "light": "neutral.0",
        "dark": "neutral.900"
      }
    },
    "text": {
      "primary": {
        "name": "Primary Text",
        "description": "Highest-emphasis readable content.",
        "light": "neutral.950",
        "dark": "neutral.50"
      },
      "secondary": {
        "name": "Secondary Text",
        "description": "Supporting content.",
        "light": "neutral.700",
        "dark": "neutral.300"
      },
      "tertiary": {
        "name": "Tertiary Text",
        "description": "Metadata and supplementary information.",
        "light": "neutral.600",
        "dark": "neutral.400"
      },
      "disabled": {
        "name": "Disabled Text",
        "description": "Content belonging to unavailable controls.",
        "light": "neutral.400",
        "dark": "neutral.600"
      },
      "placeholder": {
        "name": "Placeholder Text",
        "description": "Temporary guidance in empty fields.",
        "light": "neutral.500",
        "dark": "neutral.500"
      },
      "inverse": {
        "name": "Inverse Text",
        "description": "Text on strong surfaces.",
        "light": "neutral.0",
        "dark": "neutral.0"
      },
      "link": {
        "name": "Link Text",
        "description": "Interactive navigation and contextual actions.",
        "light": "brand.primary.700",
        "dark": "brand.primary.300"
      }
    },
    "border": {
      "subtle": {
        "name": "Subtle Border",
        "description": "Low-contrast related-content boundary.",
        "light": "neutral.200",
        "dark": "neutral.800"
      },
      "default": {
        "name": "Default Border",
        "description": "Standard component boundary.",
        "light": "neutral.300",
        "dark": "neutral.700"
      },
      "strong": {
        "name": "Strong Border",
        "description": "High-emphasis component boundary.",
        "light": "neutral.400",
        "dark": "neutral.600"
      },
      "focus": {
        "name": "Focus Border",
        "description": "Visible keyboard focus boundary.",
        "light": "brand.primary.500",
        "dark": "brand.primary.400"
      }
    },
    "interactive": {
      "primary": {
        "default": {
          "light": "brand.primary.600",
          "dark": "brand.primary.400"
        },
        "hover": {
          "light": "brand.primary.700",
          "dark": "brand.primary.300"
        },
        "pressed": {
          "light": "brand.primary.800",
          "dark": "brand.primary.200"
        },
        "disabled": {
          "light": "neutral.300",
          "dark": "neutral.700"
        }
      },
      "secondary": {
        "default": {
          "light": "brand.secondary.600",
          "dark": "brand.secondary.400"
        },
        "hover": {
          "light": "brand.secondary.700",
          "dark": "brand.secondary.300"
        },
        "pressed": {
          "light": "brand.secondary.800",
          "dark": "brand.secondary.200"
        },
        "disabled": {
          "light": "neutral.300",
          "dark": "neutral.700"
        }
      },
      "neutral": {
        "default": {
          "light": "neutral.100",
          "dark": "neutral.800"
        },
        "hover": {
          "light": "neutral.200",
          "dark": "neutral.700"
        },
        "pressed": {
          "light": "neutral.300",
          "dark": "neutral.600"
        }
      }
    },
    "status": {
      "success": {
        "default": {
          "light": "success.500",
          "dark": "success.400"
        },
        "background": {
          "light": "success.50",
          "dark": "success.900"
        },
        "border": {
          "light": "success.200",
          "dark": "success.700"
        },
        "text": {
          "light": "success.700",
          "dark": "success.200"
        }
      },
      "warning": {
        "default": {
          "light": "warning.500",
          "dark": "warning.400"
        },
        "background": {
          "light": "warning.50",
          "dark": "warning.900"
        },
        "border": {
          "light": "warning.200",
          "dark": "warning.700"
        },
        "text": {
          "light": "warning.700",
          "dark": "warning.200"
        }
      },
      "error": {
        "default": {
          "light": "error.500",
          "dark": "error.400"
        },
        "background": {
          "light": "error.50",
          "dark": "error.900"
        },
        "border": {
          "light": "error.200",
          "dark": "error.700"
        },
        "text": {
          "light": "error.700",
          "dark": "error.200"
        }
      },
      "info": {
        "default": {
          "light": "info.500",
          "dark": "info.400"
        },
        "background": {
          "light": "info.50",
          "dark": "info.900"
        },
        "border": {
          "light": "info.200",
          "dark": "info.700"
        },
        "text": {
          "light": "info.700",
          "dark": "info.200"
        }
      }
    },
    "focus": {
      "default": {
        "light": "brand.primary.500",
        "dark": "brand.primary.400"
      },
      "offset": {
        "light": "neutral.0",
        "dark": "neutral.950"
      }
    },
    "selection": {
      "background": {
        "light": "brand.primary.100",
        "dark": "brand.primary.800"
      },
      "text": {
        "light": "brand.primary.800",
        "dark": "brand.primary.100"
      }
    }
  },
  "components": {
    "button": {
      "primary": {
        "background": "interactive.primary.default",
        "backgroundHover": "interactive.primary.hover",
        "backgroundPressed": "interactive.primary.pressed",
        "backgroundDisabled": "interactive.primary.disabled",
        "text": "text.inverse",
        "textDisabled": "text.disabled",
        "focusRing": "focus.default",
        "focusOffset": "focus.offset"
      },
      "secondary": {
        "background": "interactive.secondary.default",
        "backgroundHover": "interactive.secondary.hover",
        "backgroundPressed": "interactive.secondary.pressed",
        "backgroundDisabled": "interactive.secondary.disabled",
        "text": "text.inverse",
        "textDisabled": "text.disabled",
        "focusRing": "focus.default",
        "focusOffset": "focus.offset"
      },
      "ghost": {
        "background": "transparent",
        "backgroundHover": "interactive.neutral.hover",
        "backgroundPressed": "interactive.neutral.pressed",
        "text": "text.primary",
        "focusRing": "focus.default"
      }
    },
    "input": {
      "background": "surface.default",
      "backgroundDisabled": "surface.sunken",
      "text": "text.primary",
      "placeholder": "text.placeholder",
      "textDisabled": "text.disabled",
      "border": "border.default",
      "borderHover": "border.strong",
      "borderFocus": "border.focus",
      "focusRing": "focus.default",
      "errorBorder": "status.error.border",
      "errorText": "status.error.text",
      "successBorder": "status.success.border",
      "successText": "status.success.text"
    },
    "card": {
      "background": "surface.default",
      "backgroundSubtle": "surface.subtle",
      "border": "border.subtle",
      "borderInteractive": "border.default",
      "title": "text.primary",
      "description": "text.secondary"
    },
    "link": {
      "text": "text.link",
      "textHover": "interactive.primary.hover",
      "textPressed": "interactive.primary.pressed",
      "focusRing": "focus.default"
    },
    "badge": {
      "success": {
        "background": "status.success.background",
        "text": "status.success.text",
        "border": "status.success.border"
      },
      "warning": {
        "background": "status.warning.background",
        "text": "status.warning.text",
        "border": "status.warning.border"
      },
      "error": {
        "background": "status.error.background",
        "text": "status.error.text",
        "border": "status.error.border"
      },
      "info": {
        "background": "status.info.background",
        "text": "status.info.text",
        "border": "status.info.border"
      }
    }
  },
  "accessibility": {
    "contrastStandard": "WCAG-2.2",
    "minimumContrast": {
      "normalTextAA": 4.5,
      "largeTextAA": 3.0,
      "normalTextAAA": 7.0,
      "largeTextAAA": 4.5,
      "nonTextUI": 3.0
    },
    "focus": {
      "required": true,
      "minimumContrast": 3.0,
      "mustNotRelyOnColorAlone": true
    },
    "colorIndependence": {
      "required": true,
      "description": "Color must not be the sole mechanism for communicating status, errors, selection or interaction."
    },
    "recommendedStatusPairing": {
      "success": [
        "icon",
        "text"
      ],
      "warning": [
        "icon",
        "text"
      ],
      "error": [
        "icon",
        "text"
      ],
      "info": [
        "icon",
        "text"
      ]
    }
  },
  "metadata": {
    "createdBy": "Lattice Design System",
    "usageGuidelines": [
      "Prefer semantic tokens over direct primitive references.",
      "Use brand colors primarily for identity and interaction.",
      "Use neutral colors for structure, hierarchy and content.",
      "Use semantic status colors consistently across components.",
      "Do not use color as the sole indicator of state.",
      "Do not introduce arbitrary color values inside components."
    ],
    "tokenResolution": {
      "primitive": "Actual color value.",
      "semantic": "Meaningful UI role referencing a primitive.",
      "component": "Component-specific role referencing a semantic token."
    }
  }
}
