      "scale": {
        "50": "#F0F9FF",
        "100": "#E0F2FE",
        "200": "#BAE6FD",
        "300": "#7DD3FC",
        "400": "#38BDF8",
        "500": "#0284C7",
        "600": "#0369A1",
        "700": "#075985",
        "800": "#0C4A6E",
        "900": "#082F49",
        "950": "#061C2D"
