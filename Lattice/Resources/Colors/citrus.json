      "scale": {
        "50": "#FFFBEB",
        "100": "#FEF3C7",
        "200": "#FDE68A",
        "300": "#FCD34D",
        "400": "#FBBF24",
        "500": "#D97706",
        "600": "#B45309",
        "700": "#92400E",
        "800": "#78350F",
        "900": "#451A03",
        "950": "#271003"
      }
    },
    "error": {
      "id": "error",
      "name": "Rose",
      "description": "Accessible red for destructive, invalid and failed states.",
      "scale": {
        "50": "#FFF1F2",
        "100": "#FFE4E6",
        "200": "#FECDD3",
        "300": "#FDA4AF",
        "400": "#FB7185",
        "500": "#E11D48",
        "600": "#BE123C",
        "700": "#9F1239",
