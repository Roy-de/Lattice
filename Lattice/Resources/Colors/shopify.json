{
  "id": "shopify",
  "name": "Shopify-inspired",
  "version": "2.0.0",
  "description": "A commerce-focused green palette inspired by practical, entrepreneur-friendly retail experiences.",
  "personality": "Capable, friendly, grounded and energetic.",
  "intendedFor": [
    "Business applications",
    "Customer-facing platforms",
    "Productivity tools"
  ],
  "keywords": [
    "commerce",
    "growth",
    "green",
    "retail"
  ],
  "colorModel": {
    "space": "HEX",
    "architecture": "primitive-semantic-component",
    "supportsThemes": true,
    "themes": [
      "light",
      "dark"
    ]
  },
  "primitives": {
