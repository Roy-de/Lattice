      },
      "offset": {
        "light": "neutral.0",
        "dark": "neutral.950"
      }
    },
    "selection": {
      "background": {
        "light": "brand.primary.100",
        "dark": "brand.primary.800"
      },
      "text": {
        "light": "brand.primary.800",
        "dark": "brand.primary.100"
      }
