{
  "name": "Ledger",
  "description": "Garamond display paired with Manrope for interface and body typography.",

  "fonts": {
    "Garamond": {
      "normal": {
        "variable": {
          "path": "EB_Garamond/EBGaramond-VariableFont_wght.ttf",
          "weight": [400, 800]
        },
        "static": {
          "400": "EB_Garamond/static/EBGaramond-Regular.ttf",
          "500": "EB_Garamond/static/EBGaramond-Medium.ttf",
          "600": "EB_Garamond/static/EBGaramond-SemiBold.ttf",
          "700": "EB_Garamond/static/EBGaramond-Bold.ttf",
          "800": "EB_Garamond/static/EBGaramond-ExtraBold.ttf"
        }
      },

      "italic": {
        "variable": {
          "path": "EB_Garamond/EBGaramond-Italic-VariableFont_wght.ttf",
          "weight": [400, 800]
        },
        "static": {
          "400": "EB_Garamond/static/EBGaramond-Italic.ttf",
          "500": "EB_Garamond/static/EBGaramond-MediumItalic.ttf",
          "600": "EB_Garamond/static/EBGaramond-SemiBoldItalic.ttf",
          "700": "EB_Garamond/static/EBGaramond-BoldItalic.ttf",
          "800": "EB_Garamond/static/EBGaramond-ExtraBoldItalic.ttf"
        }
      }
    },

    "Manrope": {
      "normal": {
        "variable": {
          "path": "Manrope/Manrope-VariableFont_wght.ttf",
          "weight": [200, 800]
        },
        "static": {
          "200": "Manrope/static/Manrope-ExtraLight.ttf",
          "300": "Manrope/static/Manrope-Light.ttf",
          "400": "Manrope/static/Manrope-Regular.ttf",
          "500": "Manrope/static/Manrope-Medium.ttf",
          "600": "Manrope/static/Manrope-SemiBold.ttf",
          "700": "Manrope/static/Manrope-Bold.ttf",
          "800": "Manrope/static/Manrope-ExtraBold.ttf"
        }
      }
    }
  },

  "textStyles": {
    "display": {
      "family": "Garamond",
      "weight": 700,
      "desktop": {
        "size": "56px",
        "lineHeight": "63px",
        "letterSpacing": "0em"
      },
      "mobile": {
        "size": "56px",
        "lineHeight": "63px",
        "letterSpacing": "0em"
      }
    },

    "heading-1": {
      "family": "Manrope",
      "weight": 600,
      "desktop": {
        "size": "48px",
        "lineHeight": "66px",
        "letterSpacing": "0em"
      },
      "mobile": {
        "size": "36px",
        "lineHeight": "49px",
        "letterSpacing": "0em"
      }
    },

    "heading-2": {
      "family": "Manrope",
      "weight": 600,
      "desktop": {
        "size": "40px",
        "lineHeight": "55px",
        "letterSpacing": "0em"
      },
      "mobile": {
        "size": "32px",
        "lineHeight": "44px",
        "letterSpacing": "0em"
      }
    },

    "heading-3": {
      "family": "Manrope",
      "weight": 500,
      "desktop": {
        "size": "32px",
        "lineHeight": "44px",
        "letterSpacing": "0em"
      },
      "mobile": {
        "size": "24px",
        "lineHeight": "33px",
        "letterSpacing": "0em"
      }
    },

    "heading-4": {
      "family": "Manrope",
      "weight": 400,
      "desktop": {
        "size": "24px",
        "lineHeight": "33px",
        "letterSpacing": "0em"
      },
      "mobile": {
        "size": "20px",
        "lineHeight": "27px",
        "letterSpacing": "0em"
      }
    },

    "body-large": {
      "family": "Manrope",
      "weight": 400,
      "desktop": {
        "size": "20px",
        "lineHeight": "28px",
        "letterSpacing": "0.04em"
      },
      "mobile": {
        "size": "18px",
        "lineHeight": "28px",
        "letterSpacing": "0.04em"
      }
    },

    "body": {
      "family": "Manrope",
      "weight": 400,
      "desktop": {
        "size": "16px",
        "lineHeight": "22px",
        "letterSpacing": "0em"
      },
      "mobile": {
        "size": "16px",
        "lineHeight": "22px",
        "letterSpacing": "0em"
      }
    },

    "body-small": {
      "family": "Manrope",
      "weight": 400,
      "desktop": {
        "size": "14px",
        "lineHeight": "19px",
        "letterSpacing": "0em"
      },
      "mobile": {
        "size": "14px",
        "lineHeight": "19px",
        "letterSpacing": "0em"
      }
    },

    "caption": {
      "family": "Manrope",
      "weight": 400,
      "desktop": {
        "size": "12px",
        "lineHeight": "28px",
        "letterSpacing": "0.04em"
      },
      "mobile": {
        "size": "12px",
        "lineHeight": "28px",
        "letterSpacing": "0.04em"
      }
    }
  }
}